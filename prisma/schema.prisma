generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  OPERADOR
  VISITANTE
}

enum Permiso {
  CLIENTES_VER
  CLIENTES_EDITAR
  FACTURAS_VER
  FACTURAS_EDITAR
  TICKETS_VER
  TICKETS_EDITAR
  USUARIOS_GESTIONAR
}

model Usuario {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  rol       Rol       @default(OPERADOR)
  permisos  Permiso[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  facturas  Factura[]
  tickets   Ticket[]
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String?   @unique
  telefono  String?
  rfc       String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  facturas  Factura[]
  tickets   Ticket[]
}

model Factura {
  id        Int       @id @default(autoincrement())
  folio     String    @unique
  monto     Decimal   @db.Decimal(12, 2)
  estado    String    @default("PENDIENTE")
  clienteId Int
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Ticket {
  id        Int       @id @default(autoincrement())
  titulo    String
  detalle   String
  estado    String    @default("ABIERTO")
  clienteId Int
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}